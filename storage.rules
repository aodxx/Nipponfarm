rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSafeImage(maxBytes) {
      return request.resource != null &&
             request.resource.size <= maxBytes &&
             request.resource.contentType.matches('image/.*');
    }

    match /news/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isSafeImage(10 * 1024 * 1024);
      allow delete: if isSignedIn();
    }

    match /bills/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isSafeImage(5 * 1024 * 1024);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /maintenance/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isSafeImage(10 * 1024 * 1024);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Legacy flat maintenance/<file> uploads remain compatible with the current client.
    // Explicitly require no existing object so a legacy path is create-once and immutable.
    match /maintenance/{legacyFile} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && resource == null && isSafeImage(10 * 1024 * 1024);
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isSafeImage(5 * 1024 * 1024);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /profiles/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isSafeImage(5 * 1024 * 1024);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
