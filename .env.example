# Public Firebase web configuration. These values are bundled into the browser.
# Restrict the Firebase API key to the required Firebase APIs and approved domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Leave empty to use Firestore's default database. Set this only for a named database.
VITE_FIRESTORE_DATABASE_ID=

# Application/runtime settings
APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# Protects Vercel Cron requests. Generate a long random value in Vercel.
CRON_SECRET=

# Server-only AI credential. Never prefix this value with VITE_.
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_VISION_MODEL=gemini-2.5-flash
AI_TEXT_MODEL=gemini-2.5-flash
AI_TTS_MODEL=gemini-3.1-flash-tts-preview

# SMTP Email Configuration (optional; missing values enable simulation/logging)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ImageKit.io Configuration (optional; Firebase Storage is the fallback)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Cloudflare R2 Configuration for private video storage (optional)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
