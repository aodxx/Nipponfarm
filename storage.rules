rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSafeImage(maxBytes) {
      return request.resource != null &&
             request.resource.size <= maxBytes &&
             request.resource.contentType.matches('image/.*');
    }

    match /news/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isSafeImage(10 * 1024 * 1024);
      allow delete: if isSignedIn();
    }

    match /bills/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isSafeImage(5 * 1024 * 1024);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Preferred owner-scoped path for new maintenance uploads.
    match /maintenance/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isSafeImage(10 * 1024 * 1024);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Legacy client compatibility: current app still creates flat maintenance/<file> objects.
    // Allow safe-image CREATE so existing clients keep working, but never allow overwrite/update
    // or delete on these ownerless legacy paths. Existing objects remain readable to signed-in users.
    match /maintenance/{legacyFile} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isSafeImage(10 * 1024 * 1024);
      allow update, delete: if false;
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isSafeImage(5 * 1024 * 1024);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /profiles/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isSafeImage(5 * 1024 * 1024);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
