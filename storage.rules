rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSafeImage(maxBytes) {
      return request.resource != null &&
             request.resource.size <= maxBytes &&
             request.resource.contentType.matches('image/.*');
    }

    match /news/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isSafeImage(10 * 1024 * 1024);
      allow delete: if isSignedIn();
    }

    match /bills/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isSafeImage(5 * 1024 * 1024);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Existing maintenance uploads currently use a flat maintenance/<file> path.
    // Keep signed-in compatibility until the client migrates to maintenance/<uid>/<file>,
    // but enforce image-only payloads and the same 10 MB limit as the UI.
    match /maintenance/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isSafeImage(10 * 1024 * 1024);
      allow delete: if isSignedIn();
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isSafeImage(5 * 1024 * 1024);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /profiles/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isSafeImage(5 * 1024 * 1024);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
